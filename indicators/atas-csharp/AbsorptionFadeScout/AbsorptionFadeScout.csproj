<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AbsorptionFadeScout — ATAS custom indicator
    Build: Visual Studio 2022 → Build → Build Solution
    Output: bin\Debug\net8.0\AbsorptionFadeScout.dll
    Install: copy DLL to %USERPROFILE%\Documents\ATAS\Indicators
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AbsorptionFadeScout</AssemblyName>
    <RootNamespace>Jaysuhnt.AtasIndicators.AbsorptionFadeScout</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>jaaytee78-cyber</Authors>
    <Description>Absorption Fade scout indicator for ATAS — auto-detects 4/4 of the AF setup conditions for the trader to confirm location.</Description>
  </PropertyGroup>

  <!--
    ATAS DLL references.
    These paths assume the default ATAS install location for current user.
    If your ATAS lives elsewhere, edit each HintPath below.

    Visual Studio: right-click References → Add Reference → Browse → pick these 4 files.
    That action will rewrite this section automatically.
  -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(APPDATA)\ATAS\Bin\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(APPDATA)\ATAS\Bin\ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(APPDATA)\ATAS\Bin\OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(APPDATA)\ATAS\Bin\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
